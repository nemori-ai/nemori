# === LLM Configuration ===
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1    # OpenRouter, or leave empty for direct OpenAI

# MiniMax / generic agent-compatible aliases are also accepted. AGENT_* values
# are used as LLM fallbacks when LLM_* is not set.
# AGENT_API_KEY=replace_with_a_new_key
# AGENT_BASE_URL=https://api.minimaxi.com/v1
# AGENT_MODEL=MiniMax-M2.7
# AGENT_WORK_DIR=.
# AGENT_PROVIDER=minimax
# WEB_LLM_MODE=llm
# AGENT_TEMPERATURE=0.7

# TokenRouter profile (SDK base URL; do not append /chat/completions):
# LLM_API_KEY=replace_with_your_tokenrouter_key
# LLM_BASE_URL=https://api.tokenrouter.com/v1
# NEMORI_LLM_MODEL=deepseek/deepseek-v4-flash
# NEMORI_JUDGE_MODEL=deepseek/deepseek-v4-flash
# AGENT_API_KEY=replace_with_your_tokenrouter_key
# AGENT_BASE_URL=https://api.tokenrouter.com/v1
# AGENT_MODEL=deepseek/deepseek-v4-flash
# AGENT_PROVIDER=tokenrouter

# === Embedding Configuration ===
EMBEDDING_API_KEY=your_api_key_here           # Can be same as LLM_API_KEY for OpenRouter
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# Paper-aligned OpenAI embedding (hosted API; there are no downloadable weights):
# EMBEDDING_API_KEY=sk-your-openai-api-key
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# NEMORI_EMBEDDING_MODEL=text-embedding-3-small
# Local Ollama example (api_key is required by the client but ignored by Ollama):
# EMBEDDING_API_KEY=ollama
# EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# NEMORI_EMBEDDING_MODEL=qwen3-embedding:4b

# === Database ===
# The dashboard uses isolated host ports so it can run beside another local
# evaluation stack that uses the standard PostgreSQL/Qdrant ports.
NEMORI_POSTGRES_PORT=15432
NEMORI_BIND_ADDRESS=127.0.0.1
# Dedicated bridge avoids collisions on Docker hosts with many projects.
NEMORI_DOCKER_SUBNET=10.231.0.0/24
# DSN=postgresql://nemori:nemori@localhost:15432/nemori

# === Qdrant ===
# Docker Compose host mappings used only by this Nemori stack.
NEMORI_QDRANT_HTTP_PORT=16333
NEMORI_QDRANT_GRPC_PORT=16334
NEMORI_OLLAMA_PORT=21434
# QDRANT_URL=localhost
# QDRANT_PORT=16333

# Bypass Windows/system HTTP proxies for local infrastructure.
NO_PROXY=localhost,127.0.0.1,::1

# === SWE runtime (API baseline and Nemori-memory arms) ===
NEMORI_SWE_TOKEN_BUDGET=120000
NEMORI_SWE_TIME_BUDGET=1800
NEMORI_SWE_MAX_TURNS=80
NEMORI_SWE_MAX_TOOL_CALLS=200
NEMORI_SWE_MEMORY_TIMEOUT=120
NEMORI_SWE_MAX_WORKERS=1
NEMORI_SWE_HARNESS_TIMEOUT=1800
# env balances speed and disk; use base/none when server disk is tight.
NEMORI_SWE_CACHE_LEVEL=env
NEMORI_SWE_CLEAN=true
